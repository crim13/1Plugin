{
  "name": "oneplugin/logo-module",
  "d4Shortcode": "oneplugin_divi5_logo",
  "title": "1Plugin Logo",
  "titles": "1Plugin Logos",
  "category": "module",
  "moduleClassName": "oneplugin_divi5_logo_module",
  "moduleOrderClassName": "oneplugin_divi5_logo_module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "1Plugin Logo"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "decoration": {
          "layout": {},
          "animation": {},
          "attributes": {},
          "background": {},
          "border": {},
          "boxShadow": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "interactions": {},
          "overflow": {},
          "order": {},
          "position": {},
          "scroll": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      }
    },
    "logoSettings": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "logoVariant": "auto",
              "logoLink": "",
              "logoNewTab": "off"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "logoVariant": {
              "groupSlug": "contentLogoSettings",
              "priority": 10,
              "render": true,
              "subName": "logoVariant",
              "label": "Logo Variant",
              "description": "Which logo from 1Plugin settings to display. Auto switches between main, sticky, and mobile logos based on scroll and screen size.",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "auto": { "label": "Auto (recommended)" },
                    "main": { "label": "Main logo" },
                    "sticky": { "label": "Sticky / scrolled logo" },
                    "mobile": { "label": "Mobile logo" }
                  }
                }
              }
            },
            "logoLink": {
              "groupSlug": "contentLogoSettings",
              "priority": 20,
              "render": true,
              "subName": "logoLink",
              "label": "Link URL",
              "description": "URL the logo links to. Leave empty to use the site homepage.",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "url"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "logoNewTab": {
              "groupSlug": "contentLogoSettings",
              "priority": 30,
              "render": true,
              "subName": "logoNewTab",
              "label": "Open in New Tab",
              "description": "Open the logo link in a new browser tab.",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "logoImage": {
      "type": "object",
      "selector": "{{selector}} .oneplugin-logo-link img",
      "styleProps": {
        "spacing": {
          "selector": "{{selector}} .oneplugin-logo-link"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "src": {
              "groupSlug": "contentLogoOverride",
              "priority": 10,
              "render": true,
              "subName": "src",
              "label": "Custom Image Override",
              "description": "Override the logo from plugin settings with a custom image for this module instance only.",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "image"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": {
                    "src": true,
                    "id": true,
                    "alt": true,
                    "titleText": false
                  }
                }
              }
            },
            "alt": {
              "groupSlug": "contentLogoOverride",
              "priority": 20,
              "render": true,
              "subName": "alt",
              "label": "Alt Text",
              "description": "Alternative text for the logo image. Used by screen readers and SEO. Defaults to site name.",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "text"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          }
        },
        "decoration": {
          "sizing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLogoImage",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/sizing",
                "props": { "groupLabel": "Sizing" }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLogoImage",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": { "groupLabel": "Border" }
              }
            }
          },
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLogoImage",
              "priority": 30,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": { "groupLabel": "Shadow" }
              }
            }
          },
          "filters": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLogoImage",
              "priority": 40,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/filters",
                "props": { "groupLabel": "Filters" }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLogoImage",
              "priority": 50,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": { "groupLabel": "Spacing" }
              }
            }
          }
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentLogoSettings": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentLogoSettings",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Logo" }
        }
      },
      "contentLogoOverride": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentLogoOverride",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Image Override" }
        }
      },
      "designLogoImage": {
        "panel": "design",
        "priority": 10,
        "groupName": "designLogoImage",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Image" }
        }
      }
    }
  }
}
